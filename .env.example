# ─── Locus · environment ───────────────────────────────────────────────
# Supabase project (Settings → API). OWeb satellite: use the shared One OS project.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# OWeb satellite (optional — set on locus-oweb.vercel.app)
# NEXT_PUBLIC_OWEB_SATELLITE=on
# NEXT_PUBLIC_OWEB_APP_URL=https://oweb.one
# NEXT_PUBLIC_LOCUS_PUBLIC_URL=https://locus-oweb.vercel.app
# SUPABASE_SERVICE_ROLE_KEY=<server-only — SSO redeem>

# Optional: "on" once custom SMTP is configured in Supabase (enables magic-link sign-in;
# Supabase's built-in mailer only delivers to your own project team)
NEXT_PUBLIC_AUTH_EMAILS=

# Optional: canonical origin used for auth email redirects (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=

# Migrations only (npm run db:migrate) — set ONE of these, never commit real values
DATABASE_URL=
SUPABASE_ACCESS_TOKEN=
